{
  "dashboard": {
    "title": "Hobbits Application Monitoring",
    "tags": ["hobbits", "habits", "streaks"],
    "timezone": "browser",
    "panels": [
      {
        "title": "Active Users",
        "targets": [
          {
            "expr": "hobbits_active_users"
          }
        ],
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        }
      },
      {
        "title": "Active Habits",
        "targets": [
          {
            "expr": "hobbits_active_habits"
          }
        ],
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        }
      },
      {
        "title": "Habits Created (24h)",
        "targets": [
          {
            "expr": "increase(hobbits_habits_created_total[24h])"
          }
        ],
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        }
      },
      {
        "title": "Completions (24h)",
        "targets": [
          {
            "expr": "increase(hobbits_loggings_created_total[24h])"
          }
        ],
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        }
      },
      {
        "title": "Streaks Reset (24h)",
        "targets": [
          {
            "expr": "increase(hobbits_streaks_reset_total[24h])"
          }
        ],
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 16
        }
      },
      {
        "title": "DB Operation Duration",
        "targets": [
          {
            "expr": "rate(hobbits_db_operation_duration_seconds_sum[1m])"
          }
        ],
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 16
        }
      }
    ],
    "schemaVersion": 27,
    "style": "dark",
    "refresh": "30s"
  }
}
